# ============================================================
# Monitor de Backups Veeam — configuração
# Copie para .env e preencha. O sistema não sobe se algo obrigatório faltar.
# ============================================================

# --- Web ---
APP_HOST=0.0.0.0
APP_PORT=8000
# Obrigatório, mínimo 32 caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_HOURS=12
# DB_PATH=data/monitor.db

# --- Veeam Backup & Replication (REST API, porta 9419) ---
VEEAM_URL=
# Use um usuário com papel "Veeam Backup Viewer" (somente leitura)
VEEAM_USER=
VEEAM_PASSWORD=
VEEAM_API_VERSION=1.2-rev1
# false = aceita certificado autoassinado; ou caminho para o .crt da CA
VEEAM_VERIFY_SSL=false
VEEAM_TIMEOUT_SECONDS=60

# --- Sincronização ---
SYNC_INTERVAL_MINUTES=10
# Dias de sessões/tarefas consultados a cada sync (o histórico fica guardado no banco)
HISTORY_DAYS=30

# --- RPO padrão (idade máxima aceitável do último ponto de restauração) ---
# Pode ser sobrescrito por job ou por máquina na tela.
RPO_VM_HOURS=36
RPO_AGENT_HOURS=72
